# Copy to .env or let the agent run scripts/vsum.py init.
# Relative output paths resolve from the calling workspace, not this directory.
VSUM_OUT_ROOT=outputs/vsum
VSUM_READABLE_ROOT=wiki/Clippings
VSUM_WHISPER_MODEL=small
# Omit VSUM_TMP_DIR to use the operating system's temporary directory.
# VSUM_TMP_DIR='/absolute/path/to/temporary/media'
